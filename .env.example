NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/house_wise
JWT_SECRET=generate-with-openssl-rand-base64-48
# Number of reverse proxies in front of the API (used for client IP in rate limiting)
TRUST_PROXY=0

# The web app, used for links in emails
APP_URL=http://localhost:3000
# log = print emails to the console; brevo = Brevo's HTTPS API (the default when BREVO_API_KEY is set);
# smtp = send with Nodemailer (the default when SMTP_USER is set)
EMAIL_DRIVER=log
# Gmail: SMTP_USER is the address, SMTP_PASS a 16-character App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Brevo (works on hosts that block SMTP): an API key, and EMAIL_FROM set to a sender verified in Brevo
BREVO_API_KEY=
# "Name <address>". Required for Brevo; for SMTP it defaults to "HomeWise <SMTP_USER>" (Gmail: SMTP_USER or a verified alias)
EMAIL_FROM=
# Guards POST /api/internal/jobs/:name/run (openssl rand -hex 24)
CRON_SECRET=

# Where attachments are stored: local (uploads/ folder). Cloudinary comes later.
STORAGE_DRIVER=local
# Optional: Google Gemini reads bill photos and PDFs and suggests budget splits (key from aistudio.google.com)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash
