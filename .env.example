NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/house_wise
JWT_SECRET=generate-with-openssl-rand-base64-48
# Number of reverse proxies in front of the API (used for client IP in rate limiting)
TRUST_PROXY=0

# The web app, used for links in emails
APP_URL=http://localhost:3000
# log = print emails to the console (Resend arrives with F9)
EMAIL_DRIVER=log

# Where attachments are stored: local (uploads/ folder). Cloudinary comes later.
STORAGE_DRIVER=local
